{{ 'https://fonts.googleapis.com/css2?family=Jost:wght@400;500&display=swap' | stylesheet_tag }}

{% style %}
  .gift-banner {
    font-family: 'Jost', sans-serif;
    color: #000;
    width: 100%;
    overflow: hidden;
  }

  /* HEADER */

  .gift-banner__topbar {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 60px;
    padding: 10px 50px;
    background: #f4f4f4;
  }

  .gift-banner__logo {
    justify-self: start;
    font-size: 20px;
    font-weight: 500;
  }

  /* Hamburger icon: hidden on desktop, shown on mobile */
  .gift-banner__burger {
    display: none;
  }

  .gift-banner__burger i {
    display: block;
    width: 18px;
    height: 2px;
    background: #000;
  }

  /* Mobile-only text variants: hidden on desktop */
  .gift-banner__mobile-only {
    display: none;
  }

  .gift-banner__tagline {
    justify-self: center;
    font-size: 16px;
    letter-spacing: 0;
    text-align: center;
    white-space: nowrap;
    font-weight: 400;
  }

  .gift-banner__choose {
    justify-self: end;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 207px;
    height: 44px;
    background: #fff544;
    color: #000;
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .gift-banner__choose:hover {
    background: #f4e92d;
  }

  /* HERO */

  .gift-banner__hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 0;
    width: 100%;
    height: 780px;
    padding: 0 4.45%;
    box-sizing: border-box;
    background-color: #fff;
    background-image: url('{{ "banner-desktop.png" | asset_url }}');
    background-position: center center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  /* TEXT CONTENT */

  .gift-banner__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 510px;
    padding-bottom: 48px;
  }

  .gift-banner__heading {
    margin: 0 0 46px;
    font-family: 'Jost';
    font-size: 70px;
    font-weight: 500;
    line-height: 100%;
    letter-spacing: 0;
    white-space: nowrap;
    color: #000;
  }

  .gift-banner__description {
    max-width: 483px;
    margin: 0 0 48px;
    font-family: 'Jost';
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    color: #000;
  }

  /* SHOP BUTTON */

  .gift-banner__shop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 220px;
    height: 50px;
    padding: 0 20px;
    box-sizing: border-box;
    background: #000;
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0;
  }

  .gift-banner__shop:hover {
    background: #292929;
  }

  /* BUTTON ANIMATION: smooth colour change, arrow slides right on hover */
  .gift-banner__choose,
  .gift-banner__shop {
    transition: background-color 0.3s ease;
  }

  .gift-banner__choose svg,
  .gift-banner__shop svg {
    transition: transform 0.3s ease;
  }

  .gift-banner__choose:hover svg,
  .gift-banner__shop:hover svg {
    transform: translateX(6px);
  }

  /* BOTTOM STRIP (sustainable, ethically made...) */

  .gift-banner__strip {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 10px 50px;
    box-sizing: border-box;
    background: #f4f4f4;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
  }

  /* MOBILE */

  @media screen and (max-width: 600px) {
    /* Header: burger left, logo centered, no tagline and no "Choose gift" button */
    .gift-banner__topbar {
      grid-template-columns: 1fr auto 1fr;
      height: 65px;
      padding: 0 16px;
    }

    .gift-banner__burger {
      display: flex;
      flex-direction: column;
      gap: 3px;
      justify-self: start;
    }

    .gift-banner__logo {
      justify-self: center;
      font-size: 25px;
      font-weight:bold;
    }

    .gift-banner__choose {
      display: none;
    }

    .gift-banner__tagline {
      display: none;
    }

    /* Swap desktop text for the shorter mobile text */
    .gift-banner__desktop-only {
      display: none;
    }

    .gift-banner__mobile-only {
      display: inline;
    }

    /* Hero on mobile: text on top, the mobile illustration below it */
    .gift-banner__hero {
      --mobile-image-height: 70.4vw; 
      height: auto;
      padding: 32px 20px var(--mobile-image-height);
      flex-direction: column;
      align-items: center;
      text-align: center;
      background-image: url('{{ "banner-mobile.png" | asset_url }}');
      background-position: center bottom;
      background-size: 100% auto;
    }

        .gift-banner__content {
      position: static; /* lets the "Shop now" button position itself against the hero instead */
      max-width: 100%;
      padding-bottom: 0;
    }

    .gift-banner__heading {
      font-size: 30px;
      font-weight:500;
      line-height: 100%;
      letter-spacing: 0;
      margin: 0 0 16px;
      font-family: 'Jost';
    }

    .gift-banner__description {
      max-width: 340px;
      margin: 0 auto;
      font-size: 16px;
      font-weight:400;
      line-height:130%;
      letter-spacing:0px;
      font-family: 'Jost';
    }

    /* "Shop now" floats over the lower part of the illustration */
         .gift-banner__shop {
      position: absolute;
      left: 50%;
      bottom: calc(var(--mobile-image-height) * 0.125);
      transform: translateX(-50%);
      width: 193px;
      height: 45px;
      font-size: 16px;
      font-weight: 400;
      line-height: 20.48px;
      letter-spacing: 0;
      justify-content: center;
      gap: 25px;
      font-family: 'Jost';
    }

      .gift-banner__strip {
      font-family: 'Jost';
      font-size: 14px;
      font-weight: 400;
      padding: 9px 12px;
      letter-spacing: 0;
    }
  }

  /* REMOVE THE THEME HEADER AND FOOTER FOR THIS DESIGN */

  .shopify-section-group-header-group,
  .shopify-section-group-footer-group {
    display: none;
  }
{% endstyle %}

<section class="gift-banner">

  {%- comment -%} Top bar: burger (mobile only), logo, tagline, "Choose gift" button {%- endcomment -%}
  <div class="gift-banner__topbar">
    {%- comment -%} Hamburger icon, only visible on mobile {%- endcomment -%}
    <span class="gift-banner__burger" aria-hidden="true"><i></i><i></i><i></i></span>

    <span class="gift-banner__logo">
      {{ section.settings.logo_text }}
    </span>

    <span class="gift-banner__tagline">
      {{ section.settings.tagline }}
    </span>

    <a class="gift-banner__choose" href="{{ section.settings.choose_link }}">
      <span>{{ section.settings.choose_label }}</span>

      <svg width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true">
        <path d="M0 6h22M17 1l5 5-5 5"
          stroke="currentColor"
          stroke-width="1.2"/>
      </svg>
    </a>
  </div>

  {%- comment -%} Hero: background illustration with heading, text and "Shop now" button {%- endcomment -%}
  <div class="gift-banner__hero">
    <div class="gift-banner__content">

      <h1 class="gift-banner__heading">
        {{ section.settings.heading }}
      </h1>

      <p class="gift-banner__description">
        <span class="gift-banner__desktop-only">{{ section.settings.description }}</span>
        <span class="gift-banner__mobile-only">{{ section.settings.description_mobile }}</span>
      </p>

      <a class="gift-banner__shop" href="{{ section.settings.shop_link }}">
        <span>{{ section.settings.shop_label }}</span>

        <svg width="24" height="10" viewBox="0 0 24 10" fill="none" aria-hidden="true">
          <path d="M0 5h22M18 1l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.2"/>
        </svg>
      </a>

    </div>
  </div>

  {%- comment -%} Bottom strip (different text on mobile) {%- endcomment -%}
  <div class="gift-banner__strip">
    <span class="gift-banner__desktop-only">{{ section.settings.strip_text }}</span>
    <span class="gift-banner__mobile-only">{{ section.settings.strip_text_mobile }}</span>
  </div>

</section>

{% schema %}
{
  "name": "Gift Banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "choose_label",
      "label": "Choose gift label",
      "default": "Choose gift"
    },
    {
      "type": "url",
      "id": "choose_link",
      "label": "Choose gift link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "description_mobile",
      "label": "Description (mobile)",
      "default": "Discover Joy: Your Ultimate Holiday Gift <br> Destination."
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop now label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop now link"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Bottom strip text",
      "default": "Sustainable, ethically made clothes in sizes XXS to 6XL"
    },
    {
      "type": "text",
      "id": "strip_text_mobile",
      "label": "Bottom strip text (mobile)",
      "default": "Sustainable, ethically made activewear"
    }
  ],
  "presets": [
    {
      "name": "Gift Banner"
    }
  ]
}
{% endschema %}